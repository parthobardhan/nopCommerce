[1.315278, "o", "\r\n================================================== FAILURES ==================================================\r\n_______________________________________________ test_subtract ________________________________________________\r\n\r\n    def test_subtract():\r\n>       assert subtract(5, 3) == 2\r\nE       assert 8 == 2\r\nE        +  where 8 = subtract(5, 3)\r\n\r\ntest_calc.py:10: AssertionError\r\n____________________________________________ test_divide_by_zero _____________________________________________\r\n\r\n    def test_divide_by_zero():\r\n        with pytest.raises(ValueError, match=\"zero\"):\r\n>           divide(1, 0)\r\n\r\ntest_calc.py:15: \r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n\r\na = 1, b = 0\r\n\r\n    def divide(a, b):\r\n>       return a / b  # bug: no zero check\r\n               ^^^^^\r\nE       ZeroDivisionError: division by zero\r\n\r\ncalc.py:10: ZeroDivisionError\r\n"]
