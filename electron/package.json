{
  "name": "nopcommerce-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell that loads a nopCommerce storefront",
  "homepage": "https://github.com/parthobardhan/nopCommerce",
  "author": {
    "name": "nopCommerce contributors",
    "email": "electron@localhost.invalid"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "dev:docker": "npm run build && node scripts/dev-paired.js docker",
    "dev:dotnet": "npm run build && node scripts/dev-paired.js dotnet",
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "test": "npm run build && node --test dist/*.test.js",
    "smoke": "npm run build && node scripts/smoke.js",
    "pack:dir": "npm run build && electron-builder --dir --config electron-builder.yml",
    "pack:linux": "npm run build && electron-builder --linux --config electron-builder.yml",
    "pack:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "pack:mac": "npm run build && electron-builder --mac --config electron-builder.yml"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "^22.15.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
