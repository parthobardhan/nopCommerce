# Placeholders only. Copy the names into the environment that runs electron-builder.
# Leave every value empty for an unsigned build. Never commit certificates,
# .p12/.pfx files, passwords, or Apple app-specific passwords.

# Set to false in CI and for local unsigned builds so electron-builder does not
# search the machine keychain.
CSC_IDENTITY_AUTO_DISCOVERY=

# Shared certificate. CSC_LINK may be a filesystem path or a URL. Do not commit the file.
CSC_LINK=
CSC_KEY_PASSWORD=

# Windows Authenticode overrides. Used instead of CSC_* when set.
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=

# macOS notarization. Ignored unless the app is signed.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
