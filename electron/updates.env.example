# Placeholders only. Leave empty to disable update checks.
# publish in electron-builder.yml stays null. Do not point these at a guessed server.
# There is no update server in this repo.

# Generic feed base URL, for example https://updates.example.com/nopcommerce-desktop
# The feed's latest.yml (or beta.yml) may set stagingPercentage. This repo does not.
NOPCOMMERCE_UPDATE_URL=

# stable (default, electron-updater channel "latest") or beta
NOPCOMMERCE_UPDATE_CHANNEL=

# true downloads an available update. Anything else only checks.
NOPCOMMERCE_UPDATE_AUTO_DOWNLOAD=
