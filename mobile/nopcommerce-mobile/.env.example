# Copy to .env (git-ignored). Values prefixed EXPO_PUBLIC_ are bundled into the app.
# Root URL of a nopCommerce store with the Web API Frontend plugin installed.
EXPO_PUBLIC_STORE_URL=https://demo.nopcommerce.com
# "true" = bundled fixtures (default), "false" = call the store above.
EXPO_PUBLIC_DEMO_MODE=true
