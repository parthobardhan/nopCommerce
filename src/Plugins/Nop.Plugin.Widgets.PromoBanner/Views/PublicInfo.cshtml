@model PublicInfoModel
@{
    Layout = "";
}

<link href="~/Plugins/Widgets.PromoBanner/Content/css/styles.css" rel="stylesheet">

<div class="promo-banner">
    <div class="promo-banner-content">
        <div class="promo-banner-copy">
            <h2 class="promo-banner-headline">@Model.Headline</h2>
            <p class="promo-banner-text">@Model.Text</p>
        </div>
        <a class="button-1 promo-banner-cta" href="@Model.LinkUrl">@Model.ButtonText</a>
    </div>
</div>
